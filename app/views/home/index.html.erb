<main class="main-container">
  <div class="first_view">
    <%= render 'home/app_title' %>
    <% if user_signed_in? %>
      <!-- ログイン中は何も表示しない -->
    <% else %>
      <%= render 'home/user_login' %>
    <% end %>
  </div>
  <div class="log_youtube_container">
    <%= render 'home/youtube' %>
    <%= render 'home/open_practice_log', practice_logs: @practice_logs %>
  </div>
</main>
