<%= render "shared/error", obj: song %>

<%= form_with model: song, local: true do |f| %>
  <div class="song_new_edit_field">
    <p class="song_new_edit_item"><%= f.label :title ,"曲名" %></p>
    <%= f.text_field :title, class:"song_new_edit_inputForm" %>
  </div>
  <div class="song_new_edit_field">
    <p class="song_new_edit_item"><%= f.label :artist ,"アーティスト" %></p>
    <%= f.text_field :artist, class:"song_new_edit_inputForm" %>
  </div>
  <div class="song_new_edit_field">
    <p class="song_new_edit_item"><%= f.label :genre, "ジャンル" %></p>
    <% genres = [
      "J-POP",
      "ロック",
      "バラード",
      "アニメ・ボカロ",
      "K-POP/洋楽",
      "アイドルソング",
      "ヒップホップ/R&B",
      "演歌・歌謡曲"
    ] %>
    <% genres.each do |genre| %>
      <div class="radio_item">
        <%= f.radio_button :genre, genre, id: "song_genre_#{genre.parameterize}" %>
        <%= label_tag "song_genre_#{genre.parameterize}", genre %>
      </div>
    <% end %>
  </div>
  <div class="song_new_edit_field">
    <p class="song_new_edit_item"><%= f.label :key, "キー" %></p>
    <%= f.number_field :key, class:"song_new_edit_inputForm" %>
  </div>
  <div class="song_new_edit_field">
    <p class="song_new_edit_item"><%= f.label :memo, "メモ" %></p>
    <%= f.text_area :memo, class:"song_new_edit_inputForm" %>
  </div>
  <div class="song_new_edit_actions">
    <%= f.submit "保存", class:"btnA"%>
    <%= link_to "キャンセル", mypage_path, class:"btnB" %>
  </div>
<% end %>
