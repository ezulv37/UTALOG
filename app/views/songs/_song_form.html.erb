<%= render "shared/error", obj: song %>
<%= form_with model: song, local: true, html: { class: "card" } do |f| %>
  <div class="form_group">
    <p class="form_label"><%= f.label :title ,"曲名" %></p>
    <%= f.text_field :title, class:"form_input" %>
  </div>
  <div class="form_group">
    <p class="form_label"><%= f.label :artist ,"アーティスト" %></p>
    <%= f.text_field :artist, class:"form_input" %>
  </div>
  <div class="form_group">
    <p class="form_label"><%= f.label :genre, "ジャンル" %></p>
    <div class="genre_checkboxes">
      <% genre_options.each do |genre| %>
        <div class="genre_checkbox_label">
          <%= f.radio_button :genre, genre, id: "song_genre_#{genre.parameterize}" %>
          <%= label_tag "song_genre_#{genre.parameterize}", genre, class:"radiobtn_genre_name" %>
        </div>
      <% end %>
    </div>
  </div>
  <div class="form_group">
    <p class="form_label"><%= f.label :key, "キー" %></p>
    <%= f.number_field :key, placeholder: "原曲キーを0とする", class:"form_input" %>
  </div>
  <div class="form_group">
    <p class="form_label"><%= f.label :memo, "メモ" %></p>
    <%= f.text_area :memo, class:"form_input" %>
  </div>
  <div class="actions">
    <%= f.submit "保存", class:"song_savebtn"%>
    <%= link_to "キャンセル", mypage_path, class:"song_cancelbtn" %>
  </div>
<% end %>
