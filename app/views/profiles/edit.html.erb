<div class="setting_container">
  <div class="account_information">
    <h2 class="account_information_header_title">プロフィール編集</h2>
    <%= render "users/shared/error_messages", resource: @user %>
    <%= form_with model: @user, url: user_profile_path, method: :patch, local: true, html: { multipart: true } do |f| %>
      <div class="field">
        <%= f.label :image, "アイコン画像", class:"account_edit_avatar" %>
        <div class="account_avatar_uploadform">
          <div class="edit_user_avatar_container">
            <% if @user.image.attached? %>
              <%= image_tag @user.image, size: "80x80", class:"edit_user_avatar" %>
            <% else %>
              <%= image_tag 'default_icon.png', size: "80x80", class:"edit_user_avatar" %>
            <% end %>
          </div>
          <%= f.file_field :image, class:"account_edit_input" %>
        </div>
        <%# 画像削除チェックボックス %>
        <% if @user.image.attached? %>
          <div class="remove_image_field">
            <%= f.label :remove_image, "画像を削除する", class: "avatar_delete_checkbox" %>
            <%= f.check_box :remove_image %>
          </div>
        <% end %>
      </div>
      <div class="field">
        <th><%= f.label :name, "名前", class: "account_item_title" %></th>
        <td><%= f.text_field :name, class: "account_item_inputform" %></td>
      </div>
      <div class="actions">
        <%= f.submit "保存", class: "account_edit_savebtn" %>
    <% end %>
        <%= link_to "キャンセル", :back, class: "account_edit_cancelbtn" %>
      </div>
  </div>
</div>
