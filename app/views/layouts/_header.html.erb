<header>
  <div class="header_container">
    <div class="logo_container">
      <a href="http://localhost:3000/">
        <%= image_tag 'logo.png', class: 'logo' %>
      </a>
    </div>

    <nav class="nav_item">
      <% if user_signed_in? %>
        <% if current_user.image.attached? %>
          <%= image_tag current_user.image, size: "45x45", class: "header_icon_image" %>
        <% else %>
          <%= image_tag 'default_icon.png', size: "45x45", class: "header_icon_image" %>
        <% end %>

        <div class="dropdown">
          <p class="header_username dropdown_toggle">
            <%= current_user.name.presence %> ▼
          </p>

          <div class="dropdown_menu">
            <%= link_to 'マイページ', mypage_path, class: 'dropdown_item' %><br>
            <%= link_to 'プロフィール', user_profile_path, class: 'dropdown_item' %><br>
            <%= link_to 'アカウント', user_account_path, class: 'dropdown_item' %><br>
            <%= link_to 'ログアウト', destroy_user_session_path, method: :delete, class: 'dropdown_item signout_link' %>
          </div>
        </div>

      <% else %>
        <div class="header_btns">
          <%= link_to 'ログイン', new_user_session_path, class:'signin_link' %>
          <%= link_to '新規登録', new_user_registration_path, class:'signup_link' %>
        </div>
      <% end %>
    </nav>
  </div>
</header>
