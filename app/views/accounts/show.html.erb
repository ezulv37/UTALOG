<div class="setting_container">
  <div class="account_container">
    <div class="account_information_header">
      <h3 class="account_information_header_title">アカウント</h3>
      <%= link_to '編集', edit_user_registration_path, class: 'account_edit_btn' %>
    </div>
    <table>
      <tr>
        <th>メールアドレス</th>
        <td><%= @user.email %></td>
      </tr>
      <tr>
        <th>パスワード</th>
        <td><span class="password-mask">*********</span></td>
      </tr>
    </table>
  </div>
</div>
