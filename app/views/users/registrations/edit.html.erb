<div class="setting_container">
  <div class="account_information">
    <h2>アカウント編集</h2>
    <%= render "users/shared/error_messages", resource: resource %>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <div class="field">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder:"example@email.com", class: "account_item_inputform" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
      <% end %>

      <div class="field">
        <%= f.label :password, "新しいパスワード" %>
        <%= f.password_field :password, autocomplete: "new-password", placeholder:"新しいパスワードを入力", class: "account_item_inputform" %>
        <% if @minimum_password_length %>
          <br />
          <em>最低<%= @minimum_password_length %>文字以上で入力してください</em>
        <% end %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "パスワード確認" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder:"新しいパスワードを再入力", class: "account_item_inputform" %>
      </div>

      <div class="actions">
        <%= f.submit "保存", class:"account_edit_savebtn" %>
      </div>
    <% end %>
    <%= link_to "キャンセル", :back, class:"account_edit_cancelbtn" %>
    <%= link_to "アカウントを削除", registration_path(resource_name), data: { confirm: "本当に削除しますか？", turbo_confirm: "本当に削除しますか？" }, method: :delete, class:"account_delete-btn" %>
  </div>
</div>
