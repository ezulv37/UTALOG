<main>
  <div class="auth-container">
    <h2>アカウント作成</h2>
    <%= render "users/shared/error_messages", resource: resource %>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <div class="field">
        <%= f.label :name, "ユーザー名" %>
        <%= f.text_field :name, autofocus: true, placeholder:"ユーザー名を入力", class:"signup-login-input"%>
      </div>
      <div class="field">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder:"example@email.com", class:"signup-login-input" %>
      </div>
      <div class="field">
        <%= f.label :password, "パスワード" %>
        <%= f.password_field :password, autocomplete: "new-password", placeholder:"パスワードを入力", class:"signup-login-input" %>
        <div class="password-requirements">
          <% if @minimum_password_length %>
            <em>(最低<%= @minimum_password_length %>文字以上で入力してください)</em>
          <% end %>
        </div>
      </div>
      <div class="field">
        <%= f.label :password_confirmation, "確認用パスワード" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder:"パスワードを再入力", class:"signup-login-input" %>
      </div>
      <div class="actions">
        <%= f.submit "新しいアカウントを作成", class:"submit-btn" %>
        <%= link_to 'アカウントをお持ちの方はログイン', new_user_session_path, class:'secondary-link' %>
      </div>
    <% end %>
  </div>
</main>
