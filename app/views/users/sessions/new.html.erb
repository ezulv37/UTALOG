<main>
  <div class="auth-container">
    <h2>ログイン</h2>
    <%= render "users/shared/error_messages", resource: resource %>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="field">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder:"example@email.com", class:"signup-login-input" %>
      </div>
      <div class="field">
        <%= f.label :password, "パスワード" %>
        <%= f.password_field :password, autocomplete: "current-password", placeholder:"パスワードを入力", class:"signup-login-input" %>
      </div>
      <% if devise_mapping.rememberable? %>
        <div class="field rememberable">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, "ログイン状態を保持" %>
        </div>
      <% end %>
      <div class="actions">
        <%= f.submit "ログイン", class: "submit-btn" %>
        <%= link_to 'アカウントをお持ちでない方は新規作成', new_user_registration_path, class:'secondary-link' %>
      </div>
    <% end %>
  </div>
</main>
